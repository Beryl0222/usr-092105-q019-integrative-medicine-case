{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "融合医学临床教学案领域事件",
  "description": "用于跨模块、跨课程交换事实记录的公共信封。事件不可变；更正以 CORRECTED 类事件表达。四层聚合分别为：teaching_case（授权与脱敏）、clinical_observation（事实/证候/分析）、student_plan（问题表述与各版决策）、faculty_feedback（跨学科意见/模拟/回顾/能力证据）。系统不裁定医学体系优先级，相关性不得包装为疗效。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "description": "事件唯一标识；来源系统重试时必须沿用原事件标识"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CASE_RELEASED",
        "CONSENT_WITHDRAWN",
        "ACCESS_EXPIRED",
        "OBSERVATION_ADDED",
        "OBSERVATION_CORRECTED",
        "CONFLICT_IDENTIFIED",
        "INTERACTION_FLAGGED",
        "MECHANISM_PROPOSED",
        "PROBLEM_FORMULATED",
        "PLAN_SUBMITTED",
        "OPINION_RECORDED",
        "OPINION_CORRECTED",
        "SIMULATION_RECORDED",
        "CASE_REVIEWED",
        "COMPETENCY_EVALUATED"
      ],
      "description": "本领域事件类型"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "teaching_case",
        "clinical_observation",
        "student_plan",
        "faculty_feedback"
      ],
      "description": "业务对象类型；与 event_type 的归属关系由 src/events.py 强约束"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "description": "业务对象标识"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "事实发生时间"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "对象版本，同一聚合内从 1 开始连续递增"
    },
    "summary": {
      "type": "string",
      "minLength": 2,
      "description": "中文事实摘要"
    },
    "payload": {
      "type": "object",
      "description": "事件结构化载荷。信封-only 接入方可缺省；携带时须满足 src/events.py 中各事件类型的载荷约束，权威校验以 Python 校验器为准。载荷公共字段：case_id、course_id（病例级事件除外）、actor{id,role}。"
    }
  },
  "additionalProperties": true
}
