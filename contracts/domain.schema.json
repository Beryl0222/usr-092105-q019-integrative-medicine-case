{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "融合医学临床教学案领域事件",
  "description": "用于跨模块交换事实记录的公共信封。分层内容放在信封之外的扩展字段：teaching_case 承载脱敏病例与教学同意；clinical_observation 承载症状/检查事实、证候观察、问题表述、药物相互作用、候选机制（kind 字段区分）；student_plan 承载各版决策（revision 递增）与模拟结果；faculty_feedback 承载跨学科意见、临床回顾与能力反馈。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "description": "事件唯一标识"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CASE_RELEASED",
        "CONSENT_UPDATED",
        "ACCESS_EXPIRED",
        "OBSERVATION_ADDED",
        "PLAN_SUBMITTED",
        "SIMULATION_RECORDED",
        "FEEDBACK_SIGNED"
      ],
      "description": "本领域事件类型"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "teaching_case",
        "clinical_observation",
        "student_plan",
        "faculty_feedback"
      ],
      "description": "业务对象类型"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "description": "业务对象标识"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "事实发生时间"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "对象版本"
    },
    "summary": {
      "type": "string",
      "minLength": 2,
      "description": "中文事实摘要"
    }
  },
  "additionalProperties": true
}
